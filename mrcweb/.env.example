APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Oturum yükü veritabanında tutulduğu için şifrelenir (APP_KEY ile).
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

#
#| MRC API v1 sozlesme sabitleri 
#| Sayilar mrcweb/config/api.php icerisindeki varsayilarlardir; yalniz degistirecegin
#| degeri .env'e yaz.
#|
API_VERSION=1.0.0
API_RATE_LIMIT_PER_MINUTE=120
API_IP_HARD_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=10
API_TOKEN_TTL_DAYS=90
API_SESSION_TOKEN_TTL_DAYS=14

#| Abonelik plani : yeni firmalarin baslangic plani.
#| Degerler: ucretsiz | standart | pro | sinirsiz (config/plans.php).
#| Plan DEGISTIRMEK bu surumde API ile degil sunucu konfiguru ile olur.
MRC_PLAN=standart

#
#| Online tahsilat — PayTR ve iyzico 
#| Sırlar (merchant_key/salt, api/secret key) BURADA DEGIL, firma bazında
#| `payment_credentials` tablosunda sifreli durur (Ayarlar → Ödeme Ayarları).
#| Burada yalnız ADRESLER durur: bildirim ucları tüm kiracılar için ortaktır.
#| PayTR'da sandbox sunucusu YOKTUR; deneme test_mode=1 ile yapılır
#| (firma hesabında "deneme modu" açılır).
#|
PAYTR_BASE_URL=https://www.paytr.com
PAYTR_CALLBACK_PATH=/api/paytr/callback
IYZICO_BASE_URL=https://api.iyzipay.com
IYZICO_SANDBOX_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_CALLBACK_PATH=/api/iyzico/callback

#| API dokumani uclari: /api-docs, /api-docs.json, /api-docs/postman
#| Varsayilan: yalniz APP_ENV=local iken acik. Yayinda acacaksan MRC_DOCS_KEY ver
#| ve baglantiyi sadece ekibinle paylas (anahtar bos ise giris yapmis kullanici yeterlidir).
#| Belge public/docs/ altindaki STATIK dosyalardan okunur; uretmek icin: npm run openapi
MRC_DOCS_ENABLED=false
MRC_DOCS_PATH=docs
MRC_DOCS_KEY=

#|
#| Yedek : veritabani dokumu + dosya yedegi
#| Zincir (routes/console.php): 02:00 db:dump-php -> 02:30 backup:run ->
#| 03:00 backup:clean -> 03:30 backup:monitor. cPanel'de tek cron satiri yeter:
#|   * * * * * /usr/local/bin/php /home/KULLANICI/apps/mrc/artisan schedule:run
#| Dokumler storage/app/db-dumps (mrc-*.sql.gz), zip'ler storage/app/backups/MRC/
#| (*.zip). Ikisi de webroot (public/) disidir; git'e girmez.
#|
#| SAKLAMA KURALI: yedek gunluk alinir, 7 gunluk kayan pencere tutulur.
#| 8. gun 1. gunun dosyasi silinir, yeni gunun dosyasi yazilir. Ayni deger hem
#| dokumler (db:dump-php) hem zip'ler (backup:clean) icin gecerlidir.
MRC_BACKUP_KEEP_DAYS=7

#| Dokum dosya adi on eki ve dokum oncesi istenen asgari bos alan (MB).
MRC_DB_DUMP_PREFIX=mrc
MRC_DB_DUMP_MIN_FREE_MB=100

#| Zip adi on eki: BOS birakilmali. Spatie dosya adindaki tarihi
#| (2026-10-31-02-30-00.zip) kaliba gore cozer; onek konursa cozumleme bozulur ve
#| yedegin tarihi dosya mtimesinden okunur (kopyalanan dosyada yanlis cikar).
BACKUP_FILENAME_PREFIX=

#| Disk kotasi (MB): 1000 MB'i asan en eski zip'ler silinir; denetim 1500 MB'ta
#| uyari verir. Denetim ayrica yedek 2 gunden yeniyse uyari gonderir.
BACKUP_CLEANUP_MAX_MB=1000
BACKUP_MONITOR_MAX_MB=1500
BACKUP_MAX_AGE_DAYS=2

#| Yedek basarisiz olursa / yedek 2 gunden eskiyse bu adrese mail atilir.
#| Bos birakilirsa hicbir sey gonderilmez (yedek ise calismaya devam eder).
BACKUP_NOTIFY_EMAIL=

#| Zip'i sifrelemek istersen tanimla; sifreyi ayrica sakla (zip acilmazsa yedek de
#| acilmaz). Bos birakildiysa sifreleme yok.
# BACKUP_ARCHIVE_PASSWORD=

# ---------------------------------------------------------------------------
#| SUPERADMIN HESABI (platform sahibi)
# ---------------------------------------------------------------------------
#| Parola YALNIZCA buradan gelir — depoda varsayilan parola YOKTUR. Bos birakilirsa
#| `php artisan mrc:create-superadmin` hesabi OLUSTURMAZ (bos parolali, kullanilamaz
#| ama "var" gorunen bir hesap yuzeyi olurdu).
#|
#| Parolayi degistirmek: degeri degistir + `php artisan mrc:create-superadmin`
#|
#| Entegrasyon katani (Tsoft / GIB / Luca). SIRLAR BURAYA YAZILMAZ;
#| tenant_integrations tablosunda Crypt ile saklanir. Ilk denemeler daima dry_run ile.
#| MRC_INTEGRATION_DRY_RUN=true
#| MRC_TSOFT_ENABLED=false
#| MRC_TSOFT_POLL_MINUTES=5
#| MRC_TSOFT_MAX_PER_MINUTE=60
#| MRC_GIB_ENABLED=false
#| MRC_LUCA_ENABLED=false
#| MRC_LUCA_CSV_ROWS=400
#| MRC_WEBHOOK_TOLERANCE=300

# MRC_SUPERADMIN_EMAIL=admin@example.com
# MRC_SUPERADMIN_PASSWORD=

